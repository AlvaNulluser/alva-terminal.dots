layout {
    tab name="base" focus=true {
        pane
    }

    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
              format_left   "{mode} #[fg=#7aa2f7,bold]{tabs}"
              format_center "#[fg=#7aa2f7,bold]{session}"
              format_right  "{command_git_branch} {datetime}"
              format_space  ""

              border_enabled  "false"
              border_char     "─"
              border_format   "#[fg=#414868]{char}"
              border_position "top"

              // Mode indicators — TokyoNight colors, all modes covered
              mode_normal        "#[bg=#7aa2f7,fg=#1b1d2b,bold] NORMAL "
              mode_locked        "#[bg=#f7768e,fg=#1b1d2b,bold] LOCKED "
              mode_tmux          "#[bg=#bb9af7,fg=#1b1d2b,bold]  TMUX  "
              mode_pane          "#[bg=#73daca,fg=#1b1d2b,bold]  PANE  "
              mode_tab           "#[bg=#9d7cd8,fg=#1b1d2b,bold]   TAB  "
              mode_resize        "#[bg=#e0af68,fg=#1b1d2b,bold] RESIZE "
              mode_scroll        "#[bg=#2ac3de,fg=#1b1d2b,bold] SCROLL "
              mode_search        "#[bg=#ff007c,fg=#1b1d2b,bold] SEARCH "
              mode_session       "#[bg=#b4f9f8,fg=#1b1d2b,bold] SESSION"
              mode_move          "#[bg=#ff9e64,fg=#1b1d2b,bold]  MOVE  "
              mode_entersearch   "#[bg=#ff9e64,fg=#1b1d2b,bold] SEARCH "
              mode_renametab     "#[bg=#73daca,fg=#1b1d2b,bold] RENAME "
              mode_renamepane    "#[bg=#73daca,fg=#1b1d2b,bold] RENAME "
              mode_prompt        "#[bg=#bb9af7,fg=#1b1d2b,bold] PROMPT "

              // Tabs — inactive dimmed, active bright with name
              tab_normal         "#[fg=#565f89] {index}:{name} "
              tab_active         "#[fg=#7dcfff,bold] {index}:{name} "

              // Git branch
              command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
              command_git_branch_format      "#[fg=#ff9e64]  {stdout} "
              command_git_branch_interval    "10"
              command_git_branch_rendermode  "static"

              // Date/Time
              datetime        "#[fg=#a9b1d6,bold] {format} "
              datetime_format "%A, %d %b %Y %H:%M"
            }
        }
        children
    }
}
